# Port dan Host AI Service
AI_HOST=0.0.0.0
AI_PORT=5001
AI_DEBUG=True

# Database MySQL ProjectWG (XAMPP Lokal atau VPS MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=absensi_wg

# Konfigurasi AI Face Recognition
# Pilihan Engine: auto (InsightFace -> face_recognition -> opencv)
AI_ENGINE=auto
INSIGHTFACE_MODEL=buffalo_s
ARCFACE_THRESHOLD=0.40

# Jarak maksimal embedding (standar 0.55 - 0.60; semakin kecil semakin ketat)
FACE_TOLERANCE=0.55

# Persentase skor kemiripan minimum (0 - 100%)
SIMILARITY_THRESHOLD=65.0
